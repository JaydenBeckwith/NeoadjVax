#!/bin/bash
#
# Submits the Nextflow DRIVER process itself as its own small PBS job:
# NCI's documented pattern for running Nextflow pipelines on Gadi (see
# docs/RUNNING_ON_GADI.md). This job just orchestrates: it stays cheap
# (1 cpu, modest mem) and in turn submits every pipeline step as its OWN
# qsub job via the pbspro executor already configured in conf/gadi.config
# (executor.queueSize = 30 caps how many run concurrently, matching the
# original RNA script's MAX_CONCURRENT).
#
# BEFORE first use: run bin/prefetch_containers.sh from the LOGIN node:
# this driver job runs on a compute node with no external network, so
# every container must already be cached or the run will fail on the
# first process that needs one.
#
# Usage: qsub -v PARAMS_FILE=/path/to/params.yaml bin/submit_nextflow_gadi.pbs
# (start from assets/params_somatic_gadi.example.yaml; check it first with
#  bash bin/run_somatic_gadi.sh --check /path/to/params.yaml)

#PBS -N neoadjvax_driver
#PBS -P jo11
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/jo11+gdata/jo11
#PBS -l wd
#PBS -o pbs_logs/nextflow_driver.o
#PBS -e pbs_logs/nextflow_driver.e

set -euo pipefail
module purge
module load nextflow
module load singularity

mkdir -p pbs_logs

: "${PARAMS_FILE:?pass the params file: qsub -v PARAMS_FILE=/path/to/params.yaml ...}"
export NXF_OPTS="-Xms500m -Xmx3g"
export NXF_ANSI_LOG=false
# Modules are not strict-syntax (v2) clean yet; Nextflow >= 25.10 defaults to v2.
export NXF_SYNTAX_PARSER=v1

nextflow run main.nf \
    -profile gadi \
    -params-file "${PARAMS_FILE}" \
    -work-dir "/scratch/jo11/${USER}/neoadjvax_work" \
    -resume
