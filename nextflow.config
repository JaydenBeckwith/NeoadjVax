/*
 * NeoadjVax — neoadjuvant melanoma vaccine neoantigen pipeline
 * Top-level Nextflow configuration.
 *
 * Profiles:
 *   -profile gadi        PBS Pro + Singularity on NCI Gadi (production)
 *   -profile singularity  Generic Singularity, any PBS/Slurm/local executor
 *   -profile docker       Local Docker (dev/laptop use — mirrors Jayden's
 *                         original DNA script, useful for quick iteration)
 *   -profile test         Small-scale smoke test with bundled test_data/
 */

manifest {
    name            = 'NeoadjVax'
    description     = 'Neoadjuvant melanoma neoantigen discovery: DNA + RNA variant calling, splicing, fusion, and ERV neoantigen branches feeding pVACtools'
    author          = 'Jayden Beckwith'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0-dev'
}

params {
    // ---------------------------------------------------------------
    // Pipeline mode — pick which branches run this invocation
    // ---------------------------------------------------------------
    run_dna_variant_calling   = true
    run_rna_variant_calling   = true
    run_pvacseq_core          = true   // DNA+RNA matched variants -> pVACseq
    run_splicing_neoantigens  = false  // new territory — see docs/ARCHITECTURE.md
    run_fusion_neoantigens    = false  // new territory — see docs/ARCHITECTURE.md
    run_erv_neoantigens       = false  // new territory — see docs/ARCHITECTURE.md
    run_purity_ploidy         = false  // Sequenza tumor purity/ploidy — STUB, see docs/ARCHITECTURE.md
    run_hla_loh               = false  // SpecHLA HLA loss-of-heterozygosity — see docs/ARCHITECTURE.md

    // ---------------------------------------------------------------
    // Input
    // ---------------------------------------------------------------
    // Two sheets, not one: DNA (WGS/WES) is drawn once per patient at
    // baseline, RNA is longitudinal (PRE/ED1/ED2/CLND...) — forcing them
    // into one row-per-timepoint sheet would mean repeating or blanking
    // DNA columns on every RNA row. See assets/samplesheet_schema.md.
    dna_samplesheet = null   // patient_id,tumor_r1,tumor_r2,normal_r1,normal_r2,tumor_bam,normal_bam,hla_alleles
    rna_samplesheet = null   // patient_id,timepoint,rna_bam OR rna_fastq_r1,rna_fastq_r2

    // Skip alignment when the input is already aligned. DNA: per-row —
    // supply tumor_bam/normal_bam instead of tumor_r1/r2 etc. and those
    // sample_types skip trim+BWA automatically (see assets/samplesheet_schema.md).
    // RNA: a pipeline-wide switch, since the original script always
    // realigned rna_bam rows through STAR two-pass for consistency — set
    // this true only if your BAMs already match this pipeline's STAR
    // settings (--outFilterMultimapNmax 2, two-pass), otherwise realign.
    rna_skip_realignment = false

    // ---------------------------------------------------------------
    // Reference data (defaults point at Jayden's existing Gadi paths —
    // override per-environment via -profile or a params file)
    // ---------------------------------------------------------------
    genome_fasta   = '/scratch/jo11/GRCh38.fa/GRCh38.primary_assembly.genome.fa'
    gtf            = '/scratch/jo11/GRCh38.fa/gencode.v46.chr_patch_hapl_scaff.annotation.gtf'
    star_index_dir = '/scratch/jo11/STAR_index_GRCh38_gencode46'

    known_mills  = '/scratch/jo11/NeoTrio_RNA/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz'
    known_1000g  = '/scratch/jo11/NeoTrio_RNA/1000G_phase1.snps.high_confidence.hg38.vcf.gz'
    known_dbsnp  = '/scratch/jo11/NeoTrio_RNA/dbsnp_138.hg38.vcf.gz'

    vep_cache   = null   // path to local VEP cache (--offline --cache)
    vep_plugins = null   // path to VEP plugin dir (needs Wildtype + Frameshift plugins for pVACseq)

    // BRAF V600 locus (hg38) — carried over from the RNA script; used for the
    // quick-look allelic-count sanity check, independent of the main variant calls
    braf_chrom = 'chr7'
    braf_pos   = 140753336

    // ---------------------------------------------------------------
    // HLA typing / pVACtools
    // ---------------------------------------------------------------
    hla_alleles_manual = null   // comma-separated override; skips the typing module if set
    // MHCflurry is class I only. xHLA (modules/local/hla_typing/xhla.nf) types
    // class I + DRB1 (class II) both, but DRB1 alleles reaching pVACseq won't
    // actually get predicted against until a class II algorithm is added here
    // too (e.g. 'MHCflurry,MHCnuggetsII' or similar — confirm what's actually
    // installed in the griffithlab/pvactools container via `pvacseq valid_alleles`
    // before picking one; some IEDB-bundled predictors are license-gated and
    // may not ship in the public image).
    pvacseq_algorithms = 'MHCflurry'
    pvacseq_threads     = 4

    // ---------------------------------------------------------------
    // DNA-RNA variant matching
    // ---------------------------------------------------------------
    min_rna_alt_reads = 1   // 0 = RNA presence-only, no depth threshold

    // ---------------------------------------------------------------
    // Splicing / fusion / ERV branches (placeholders — see ARCHITECTURE.md)
    // ---------------------------------------------------------------
    spliceai_annotated_vcf_dir = null   // reuse of the existing Gadi SpliceAI pipeline output
    fusion_caller               = 'starfusion'
    ctat_resource_lib           = null  // required by STAR-Fusion
    erv_annotation_gtf          = null  // e.g. RepeatMasker/hervd/Telescope-formatted GTF

    // ---------------------------------------------------------------
    // Tumor purity/ploidy (Sequenza) — --run_purity_ploidy
    // Ported from https://github.com/JaydenBeckwith/Sequenza_tools's four
    // PBS scripts. bam2seqz/binning/merge/fit orchestration is real; the
    // final purity/ploidy extraction is a stub pending run-sequenza.R's
    // actual output format — see workflows/purity_ploidy.nf and
    // modules/local/purity_ploidy/sequenza_extract_top_solution.nf.
    // ---------------------------------------------------------------
    sequenza_bin_wgs = 200   // matches sequenza_step1.sh's hardcoded -w 200
    sequenza_bin_wes = 50    // your stated WES convention — UNVERIFIED against
                             // merge-bin200-files.pl, whose own name bakes in
                             // "200"; see sequenza_merge_bins.nf's comment.
    sequenza_seq_type = 'wgs'   // 'wgs' or 'wes' — picks bin size above; the
                                 // original script only ever ran WGS
    sequenza_gc_file  = '/scratch/jo11/neoadjuvant/hg38.gc50Base.txt.gz'
    // dna_neotrio_gender_metadata.csv format from sequenza_step2.sh/step4.sh's
    // get_gender(): column 2 = numeric "melpin" id (matched against the
    // leading digits of the sample id), column 7 = gender, header row
    // present. No default path — this is a per-cohort metadata file, not
    // a fixed reference, so it must be supplied explicitly.
    sequenza_gender_csv = null
    // Standard sequenza-utils seqz format header, reconstructed from public
    // docs (NOT your actual assets/seqz.header — you didn't send one; see
    // modules/local/purity_ploidy/sequenza_merge_bins.nf's comment).
    sequenza_seqz_header = "${projectDir}/assets/seqz.header"
    // r_sequenza conda env used by sequenza_step2.sh/step4.sh — NOT the
    // Singularity container. The original path is under a personal Gadi
    // home directory (/home/562/jb1592/...) — EDIT ME to wherever this
    // conda env actually lives before a real run.
    sequenza_conda_sh          = '/home/562/jb1592/miniconda3/etc/profile.d/conda.sh'
    sequenza_conda_bin_fallback = '/home/562/jb1592/miniconda3/bin'
    sequenza_conda_env         = 'r_sequenza'

    // ---------------------------------------------------------------
    // HLA loss-of-heterozygosity (SpecHLA) — --run_hla_loh
    // Ported from https://github.com/JaydenBeckwith/NeoadjLOH. Standalone
    // input (only needed without --run_dna_variant_calling):
    hla_loh_samplesheet = null   // patient_id,tumor_bam,purity,ploidy — see assets/samplesheet_schema.md
    // Manual purity/ploidy when chaining off DNA_VARIANT_CALLING's tumor
    // BAM but not (yet) running --run_purity_ploidy — same shape as
    // NeoadjLOH's PURITY_CSV: sample,purity,ploidy (comma-delimited; the
    // original config.sh's comment says "assumed TAB-delimited" but its own
    // submit_all.sh already parses it with IFS=',' — the comment is stale,
    // comma is what actually runs, kept that way here too).
    purity_ploidy_csv   = null
    spechla_ref_build   = 'hg38'
    // EDIT ME if needed — carried over from NeoadjLOH/specHLA/config.sh's
    // own caveat that neither of you had inspected this specific .sif's
    // internals yet at the time it was written. Confirm these three paths
    // still resolve inside it before a real run:
    //   singularity exec <spechla.sif> bash -lc \
    //     'find / -xdev -iname "ExtractHLAread.sh" -o -iname "SpecHLA.sh" -o -iname "cal.hla.copy.pl"'
    spechla_extract_cmd = '/opt/SpecHLA/script/ExtractHLAread.sh'
    spechla_typing_cmd  = 'bash /opt/SpecHLA/script/whole/SpecHLA.sh'
    spechla_loh_cmd      = 'perl /opt/SpecHLA/script/cal.hla.copy.pl'

    // ---------------------------------------------------------------
    // Output
    // ---------------------------------------------------------------
    outdir       = './results'
    tracedir     = "${params.outdir}/pipeline_info"

    // ---------------------------------------------------------------
    // Container images. Under -profile gadi or -profile singularity (the
    // two profiles actually meant for running this), EVERY entry below is
    // pulled and run through Singularity — Docker itself is never invoked,
    // and Gadi's compute nodes don't have Docker installed at all (no root
    // access on HPC), so this has to be Singularity-only to run there.
    // A `docker://...` value (e.g. pvactools below) is just an image
    // *reference* — Singularity pulls straight from Docker Hub/Quay and
    // converts to a .sif on first run, same as any other entry here; it
    // does not mean Docker is used to run it.
    // The .sif paths (star/picard/gatk/samtools) reuse Jayden's existing
    // Gadi images; everything else resolves to depot.galaxyproject.org
    // (Biocontainers/Seqera) or Docker Hub and gets cached under Nextflow's
    // singularity cache dir after the first pull.
    // `-profile docker` exists purely as an optional local-dev convenience
    // (mirrors the original DNA script's Docker-based approach) for
    // iterating off Gadi, e.g. on a laptop with Docker Desktop — it is not
    // how this pipeline runs in production.
    // ---------------------------------------------------------------
    containers {
        star      = '/scratch/jo11/singularity_images/star_2.7.11b--h43eeafb_0.sif'
        picard    = '/scratch/jo11/singularity_images/picard.sif'
        gatk      = '/scratch/jo11/singularity_images/gatk_4.5.0.0.sif'
        samtools  = '/scratch/jo11/singularity_images/samtools_v1.3.1_cv4.sif'
        bwa       = 'https://depot.galaxyproject.org/singularity/bwa:0.7.17--hed695b0_7'
        trimgalore = 'https://depot.galaxyproject.org/singularity/trim-galore:0.6.10--hdfd78af_0'
        fastqc    = 'https://depot.galaxyproject.org/singularity/fastqc:0.12.1--hdfd78af_0'
        vep       = 'https://depot.galaxyproject.org/singularity/ensembl-vep:111.0--pl5321h2a3209d_0'
        pvactools = 'docker://griffithlab/pvactools:latest'
        starfusion = 'https://depot.galaxyproject.org/singularity/star-fusion:1.13.0--hdfd78af_2'
        telescope = 'https://depot.galaxyproject.org/singularity/telescope:1.0.3--py38h24c8ff8_1'
        // xHLA — class I + II HLA typing from one BAM (modules/local/hla_typing/xhla.nf).
        // Tag 0.0.0 confirmed via a third-party Nextflow wrapper's Dockerfile
        // (alexvpickering/nf-xhla), not xHLA's own docs — worth a sanity check.
        xhla      = 'docker://humanlongevity/hla:0.0.0'
        // SpecHLA — HLA-LOH branch (modules/local/hla_loh/*.nf), ported from
        // https://github.com/JaydenBeckwith/NeoadjLOH's config.sh SIF path.
        // Already a local .sif on Gadi scratch, same category as
        // star/picard/gatk/samtools above — no pre-fetch into the shared
        // Singularity cache needed (see bin/prefetch_containers.sh).
        spechla   = '/scratch/jo11/singularity_images/spechla_1.0.9-imgt3.57.0.sif'
        // sequenza_utils — bam2seqz/seqz_binning only (SEQUENZA_BAM2SEQZ_BINNED).
        // SEQUENZA_MERGE_BINS/SEQUENZA_FIT run outside this container, in the
        // r_sequenza conda env instead — see those modules' comments for why.
        // Local .sif on Gadi scratch, same category as star/picard/gatk/
        // samtools/spechla above — no pre-fetch needed.
        sequenza  = '/scratch/jo11/singularity_images/sequenza_latest.sif'
    }
}

// ---------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------
profiles {
    gadi {
        includeConfig 'conf/gadi.config'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    docker {
        docker.enabled  = true
        singularity.enabled = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}

includeConfig 'conf/base.config'

// ---------------------------------------------------------------------
// Execution reports
// ---------------------------------------------------------------------
timeline { enabled = true; file = "${params.tracedir}/execution_timeline.html" }
report   { enabled = true; file = "${params.tracedir}/execution_report.html" }
trace    { enabled = true; file = "${params.tracedir}/execution_trace.txt" }
dag      { enabled = true; file = "${params.tracedir}/pipeline_dag.svg" }
