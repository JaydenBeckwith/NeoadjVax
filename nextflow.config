/*
 * NeoadjVax: somatic neoantigen prediction for neoadjuvant melanoma vaccines
 * Top-level Nextflow configuration.
 *
 * Profiles:
 *   -profile gadi         PBS Pro + Singularity on NCI Gadi (production)
 *   -profile singularity  Generic Singularity, any executor
 *   -profile docker       Local Docker (development only)
 */

manifest {
    name            = 'NeoadjVax'
    description     = 'Somatic neoantigen prediction: tumour/normal DNA -> Mutect2 -> HLA-HD -> proximal-variant phasing -> bam-readcount -> pVACseq'
    author          = 'Jayden Beckwith'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.2.0-dev'
}

params {
    // ---------------------------------------------------------------
    // Input: one row per patient, tumour + matched normal DNA, Sequenza
    // purity (required) and ploidy/segments (optional). See
    // assets/samplesheet_schema.md.
    // ---------------------------------------------------------------
    samplesheet = null
    outdir      = './results'
    tracedir    = "${params.outdir}/pipeline_info"

    // ---------------------------------------------------------------
    // Reference: GRCh38, chr-prefixed. Indexes (.fai, .dict, BWA) beside
    // the FASTA are reused; missing ones are built once per run.
    // ---------------------------------------------------------------
    genome_fasta = '/scratch/jo11/GRCh38.fa/GRCh38.primary_assembly.genome.fa'

    // BQSR known sites (GATK hg38 resource bundle), each with a .tbi
    known_dbsnp = '/scratch/jo11/NeoTrio_RNA/dbsnp_138.hg38.vcf.gz'
    known_mills = '/scratch/jo11/NeoTrio_RNA/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz'
    known_1000g = '/scratch/jo11/NeoTrio_RNA/1000G_phase1.snps.high_confidence.hg38.vcf.gz'

    // ---------------------------------------------------------------
    // Mutect2 (GATK somatic best-practice resources, hg38 bundle)
    // ---------------------------------------------------------------
    germline_resource   = null   // af-only-gnomad.hg38.vcf.gz (required)
    panel_of_normals    = null   // 1000g_pon.hg38.vcf.gz or a cohort PoN (strongly recommended)
    contamination_sites = null   // small_exac_common_3.hg38.vcf.gz; unset skips contamination estimation
    target_intervals    = null   // WES capture BED/interval_list; unset for WGS
    // Mutect2 runs one task per entry; calls outside these contigs are not made
    scatter_chromosomes = 'chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY'

    // ---------------------------------------------------------------
    // HLA-HD (normal DNA)
    // ---------------------------------------------------------------
    // MHC on GRCh38 (GRC definition) plus nothing else: unplaced unmapped
    // reads are always added. Space-separated if more than one region.
    // HLA-HD is licence-gated: build containers/hlahd from your own download
    // and set this to the resulting .sif. A top-level param (not under
    // containers) so a params file can set it without replacing that map.
    hlahd_container       = null
    hlahd_regions         = 'chr6:28510120-33480577'
    hlahd_install_dir     = '/opt/hlahd'   // inside the HLA-HD container
    hlahd_min_read_length = 100            // HLA-HD -m; lower it for reads shorter than 2x100

    // ---------------------------------------------------------------
    // Proximal-variant phasing
    // ---------------------------------------------------------------
    phasing_window_bp = 200   // germline calling window either side of each somatic site
    germline_min_qual = 30    // HaplotypeCaller QUAL needed for a germline variant to be phased in

    // ---------------------------------------------------------------
    // VEP (cache and plugins must match the container's VEP release;
    // plugins dir needs pVACtools' Wildtype.pm and Frameshift.pm)
    // ---------------------------------------------------------------
    vep_cache         = null
    vep_plugins       = null
    vep_cache_version = 111
    vep_assembly      = 'GRCh38'

    // ---------------------------------------------------------------
    // bam-readcount (pVACtools input prep)
    // ---------------------------------------------------------------
    readcount_min_base_quality    = 20
    readcount_min_mapping_quality = 0

    // ---------------------------------------------------------------
    // pVACseq
    // ---------------------------------------------------------------
    // Space-separated. NetMHCpan/NetMHCIIpan run from the standalone IEDB
    // install inside the griffithlab/pvactools image.
    pvacseq_algorithms        = 'MHCflurry MHCflurryEL NetMHCpan NetMHCpanEL NetMHCIIpan NetMHCIIpanEL'
    pvacseq_iedb_install_dir  = '/opt/iedb'
    pvacseq_class_i_lengths   = '8,9,10,11'
    pvacseq_class_ii_lengths  = '12,13,14,15,16,17,18'
    pvacseq_extra_args        = ''   // passed through verbatim, e.g. '--binding-threshold 500 --tdna-vaf 0.05'

    // ---------------------------------------------------------------
    // Containers. Under -profile gadi every entry runs through
    // Singularity; docker:// and https:// entries are pulled once into the
    // shared cache by bin/prefetch_containers.sh (Gadi compute nodes have
    // no network). Seqera community images are the ones nf-core/modules
    // pins for the same tools.
    // ---------------------------------------------------------------
    containers {
        fastqc        = 'https://depot.galaxyproject.org/singularity/fastqc:0.12.1--hdfd78af_0'
        trimgalore    = 'https://depot.galaxyproject.org/singularity/trim-galore:0.6.10--hdfd78af_0'
        // bwa + samtools in one image: BWA_MEM_ALIGN pipes bwa into samtools sort
        bwa           = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/d7/d7e24dc1e4d93ca4d3a76a78d4c834a7be3985b0e1e56fddd61662e047863a8a/data'
        samtools      = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/c2/c2f02ceb8cbe5aa37930dcbc0de6f1d07dfb292178c7e780c44ab2f556bf829f/data'
        bcftools      = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/16/164b5421d87e69f8e9f5add5a937e148e8165f11bfb18159da607f56ecdb1495/data'
        whatshap      = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/d8/d837709891c2d98fc0956f6fd0dba18b0f67d96c4db74ccbae7db98fd00afe42/data'
        picard        = '/scratch/jo11/singularity_images/picard.sif'
        gatk          = '/scratch/jo11/singularity_images/gatk_4.5.0.0.sif'
        vep           = 'https://depot.galaxyproject.org/singularity/ensembl-vep:111.0--pl5321h2a3209d_0'
        bam_readcount = 'docker://mgibio/bam_readcount_helper-cwl:1.1.1'
        vatools       = 'docker://griffithlab/vatools:5.1.1'
        pvactools     = 'docker://griffithlab/pvactools:7.1.3'
    }
}

profiles {
    gadi {
        includeConfig 'conf/gadi.config'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    docker {
        docker.enabled      = true
        singularity.enabled = false
    }
}

includeConfig 'conf/base.config'

timeline { enabled = true; file = "${params.tracedir}/execution_timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/execution_report.html"; overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/execution_trace.txt"; overwrite = true }
dag      { enabled = true; file = "${params.tracedir}/pipeline_dag.html"; overwrite = true }
