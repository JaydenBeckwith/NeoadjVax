/*
 * Base resource requirements, keyed by process label.
 * Numbers below are carried over from Jayden's existing PBS scripts
 * (star_index_build: 24 cpus/128GB/48h; per-sample RNA jobs: 12 cpus/48GB/48h)
 * so behaviour on Gadi doesn't change, just the orchestration layer.
 */

process {
    cpus   = { 2    * task.attempt }
    memory = { 8.GB  * task.attempt }
    time   = { 4.h   * task.attempt }

    errorStrategy = { task.exitStatus in [130, 143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: 'process_low' {
        cpus   = { 2  * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = { 12 * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = { 24 * task.attempt }
        memory = { 128.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }
    withLabel: 'process_long' {
        time   = { 48.h * task.attempt }
    }
    withLabel: 'error_ignore' {
        errorStrategy = 'ignore'
    }
}
