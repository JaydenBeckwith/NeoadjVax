/*
 * Base resource requirements, keyed by process label. process_low/medium/
 * high carry over from Jayden's original PBS scripts; process_mutect2 is
 * one chromosome of one patient, process_pvacseq one patient's full
 * class I + II prediction run.
 */

process {
    cpus   = { 2    * task.attempt }
    memory = { 8.GB  * task.attempt }
    time   = { 4.h   * task.attempt }

    errorStrategy = { task.exitStatus in [130, 143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: 'process_low' {
        cpus   = { 2  * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = { 12 * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = { 24 * task.attempt }
        memory = { 128.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }
    withLabel: 'process_mutect2' {
        cpus   = { 4  * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withLabel: 'process_pvacseq' {
        cpus   = { 8  * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withLabel: 'process_long' {
        time   = { 48.h * task.attempt }
    }
    withLabel: 'error_ignore' {
        errorStrategy = 'ignore'
    }
}
