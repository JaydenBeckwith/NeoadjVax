/*
 * NCI Gadi execution profile.
 * Mirrors the PBS Pro settings hardcoded in Jayden's original
 * RNA_variant_pipeline.sh (project jo11, storage scratch/jo11+gdata/jo11,
 * queue normal): pulled into params so they're set once, not per-script.
 *
 * See docs/RUNNING_ON_GADI.md for how to actually launch this (the
 * Nextflow driver itself needs its own small PBS job or a login-node
 * screen session: Gadi compute nodes have no external network, so every
 * container this pipeline uses must be pre-pulled into the shared
 * singularity.cacheDir below before any -profile gadi run).
 *
 * Usage: nextflow run main.nf -profile gadi --pbs_project <proj> ...
 */

params {
    pbs_project = 'jo11'
    pbs_queue   = 'normal'
    pbs_storage = 'scratch/jo11+gdata/jo11'
}

process {
    executor = 'pbspro'
    queue    = params.pbs_queue

    clusterOptions = "-P ${params.pbs_project} -l storage=${params.pbs_storage} -l wd"

    // Gadi 'normal' queue nodes: 48 cpus / 192GB: keep per-job asks within
    // a single node unless a step is explicitly split across chromosomes.
    withLabel: 'process_high' {
        clusterOptions = "-P ${params.pbs_project} -l storage=${params.pbs_storage} -l wd"
    }
}

executor {
    // Matches MAX_CONCURRENT=30 from the original per-sample submission loop
    queueSize = 30
    submitRateLimit = '10/1min'
}

singularity {
    enabled    = true
    autoMounts = true
    // Gadi requires /scratch and /g/data to be explicitly bound
    runOptions = '--bind /scratch --bind /g/data'
    // Shared cache so every container is pulled ONCE (from a node with
    // network: see docs/RUNNING_ON_GADI.md) rather than each compute-node
    // task trying and failing to pull it fresh. Pattern (including the
    // System.getenv, not a bare $USER: Groovy would try to resolve that
    // as an undefined variable) matches nf-core's own nci_gadi config.
    cacheDir = "/scratch/${params.pbs_project}/${System.getenv('USER')}/nxf_singularity_cache"
}

docker.enabled = false

// module load singularity is required on Gadi login/compute nodes before
// the scheduler hands off to Nextflow's own singularity invocation
process.beforeScript = 'module load singularity'
