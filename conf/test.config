/*
 * Minimal-resource profile template for smoke-testing the pipeline
 * structure (not real variant-calling accuracy) against a local test_data/
 * fixture. The repository does not bundle sequencing/reference data, so
 * provide both current samplesheets when using this profile.
 */

params {
    genome_fasta   = 'test_data/chr21_subset.fa'
    gtf            = 'test_data/chr21_subset.gtf'
    star_index_dir = 'test_data/star_index_chr21'
    dna_samplesheet = 'test_data/dna_samplesheet_test.csv'
    rna_samplesheet = 'test_data/rna_samplesheet_test.csv'
    outdir         = './results_test'
}

process {
    cpus   = 2
    memory = 6.GB
    time   = 1.h
}

docker.enabled      = false
singularity.enabled = true
