/*
 * Minimal-resource profile for smoke-testing the pipeline structure
 * (not real variant-calling accuracy) against files under test_data/.
 * Fill in test_data/ with a small chr21-subset BAM/FASTQ pair before use.
 */

params {
    genome_fasta   = 'test_data/chr21_subset.fa'
    gtf            = 'test_data/chr21_subset.gtf'
    star_index_dir = 'test_data/star_index_chr21'
    input          = 'test_data/samplesheet_test.csv'
    outdir         = './results_test'
}

process {
    cpus   = 2
    memory = 6.GB
    time   = 1.h
}

docker.enabled      = false
singularity.enabled = true
