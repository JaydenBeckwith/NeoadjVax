// Valid generated BAMs, stubbed analysis tools: workflow wiring, not accuracy.
// Run from repo root; first generate tests/dna_somatic/generated via make_fixture.py.
params {
    pipelines = 'somatic_neoantigen'
    dna_samplesheet = "${projectDir}/tests/dna_somatic/generated/samples_dna.csv"
    rna_samplesheet = "${projectDir}/tests/dna_somatic/generated/samples_rna.csv"
    rna_skip_realignment = true
    genome_fasta = "${projectDir}/tests/dna_somatic/generated/genome.fa"
    gtf = "${projectDir}/tests/dna_somatic/generated/genome.gtf"
    known_mills = "${projectDir}/tests/dna_somatic/generated/known_mills.vcf"
    known_1000g = "${projectDir}/tests/dna_somatic/generated/known_1000g.vcf"
    known_dbsnp = "${projectDir}/tests/dna_somatic/generated/known_dbsnp.vcf"
    vep_cache = "${projectDir}/tests/dna_somatic/generated/vep_cache"
    vep_plugins = "${projectDir}/tests/dna_somatic/generated/vep_plugins"
    outdir = './test-results/dna_somatic'
}
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    time = '5 min'
    maxForks = 2
    errorStrategy = 'terminate'
    withLabel: '.*' {
        cpus = 1
        memory = '1 GB'
        time = '5 min'
    }
}
docker.enabled = false
singularity.enabled = false
trace {
    enabled = true
    file = 'test-results/dna_somatic/trace.tsv'
    fields = 'task_id,process,name,status,exit'
}
