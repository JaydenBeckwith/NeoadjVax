// Structural smoke test only, run through main.nf itself (not a
// hand-built smoke.nf like the other branches): --pipelines
// somatic_neoantigen exercises DNA_VARIANT_CALLING + RNA_VARIANT_CALLING
// + PVACSEQ_CORE together the same way a real invocation would, so this
// also regression-tests main.nf's own wiring (samplesheet validation,
// --pipelines resolution, workflow.onComplete registration), not just one
// workflow file in isolation.
//
// P1 supplies already-aligned tumor/normal DNA BAMs (skips FASTQC/Trim
// Galore/BWA-MEM) and an already-aligned RNA BAM with
// rna_skip_realignment=true (skips BAM-to-FASTQ/STAR realignment), and a
// manual hla_alleles override (skips xHLA typing): keeps this run to the
// steps that are always exercised regardless of samplesheet tier
// (BWA_INDEX/SAMTOOLS_FAIDX/PICARD_CREATE_SEQUENCE_DICTIONARY/STAR_INDEX/
// TABIX_INDEX, then AddReadGroups through Mutect2/pVACseq) rather than
// every possible input path. None of the BAMs/VCFs/references below are
// real sequencing data: -stub-run never reads their bytes, it only needs
// the paths to exist and each process's stub: block to produce output
// filenames matching what the next step expects.
params {
    pipelines             = 'somatic_neoantigen'
    dna_samplesheet       = 'tests/dna_somatic/samples_dna.csv'
    rna_samplesheet       = 'tests/dna_somatic/samples_rna.csv'
    rna_skip_realignment  = true
    genome_fasta = 'tests/dna_somatic/genome.fa'
    gtf          = 'tests/dna_somatic/genome.gtf'
    known_mills  = 'tests/dna_somatic/known_mills.vcf'
    known_1000g  = 'tests/dna_somatic/known_1000g.vcf'
    known_dbsnp  = 'tests/dna_somatic/known_dbsnp.vcf'
    vep_cache    = 'tests/dna_somatic/vep_cache'
    vep_plugins  = 'tests/dna_somatic/vep_plugins'
    outdir = './test-results/dna_somatic'
}
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    // conf/base.config's per-label cpu/memory requests (up to 128 GB, 24
    // cpus for process_high) load too now that this is combined with the
    // repo's own nextflow.config via `-c` rather than replacing it: cap
    // every label back down for this structural-only smoke test.
    withLabel: '.*' {
        cpus = 1
        memory = '1 GB'
    }
}
docker.enabled = false
singularity.enabled = false
