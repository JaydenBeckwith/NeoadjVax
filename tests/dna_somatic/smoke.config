// Valid generated BAMs/FASTQs, stubbed analysis tools: workflow wiring, not accuracy.
// Run from repo root; first generate tests/dna_somatic/generated via make_fixture.py.
params {
    samplesheet         = "${projectDir}/tests/dna_somatic/generated/samplesheet.csv"
    genome_fasta        = "${projectDir}/tests/dna_somatic/generated/genome.fa"
    known_dbsnp         = "${projectDir}/tests/dna_somatic/generated/known_dbsnp.vcf.gz"
    known_mills         = "${projectDir}/tests/dna_somatic/generated/known_mills.vcf.gz"
    known_1000g         = "${projectDir}/tests/dna_somatic/generated/known_1000g.vcf.gz"
    germline_resource   = "${projectDir}/tests/dna_somatic/generated/germline_resource.vcf.gz"
    panel_of_normals    = "${projectDir}/tests/dna_somatic/generated/panel_of_normals.vcf.gz"
    contamination_sites = "${projectDir}/tests/dna_somatic/generated/contamination_sites.vcf.gz"
    vep_cache           = "${projectDir}/tests/dna_somatic/generated/vep_cache"
    vep_plugins         = "${projectDir}/tests/dna_somatic/generated/vep_plugins"
    scatter_chromosomes = 'chr1'
    hlahd_container     = 'stub-only-hlahd-image'
    outdir              = './test-results/dna_somatic'
}
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    time = '5 min'
    maxForks = 2
    errorStrategy = 'terminate'
    withLabel: '.*' {
        cpus = 1
        memory = '1 GB'
        time = '5 min'
    }
}
docker.enabled = false
singularity.enabled = false
trace {
    enabled = true
    file = 'test-results/dna_somatic/trace.tsv'
    overwrite = true
    fields = 'task_id,process,name,status,exit'
}
