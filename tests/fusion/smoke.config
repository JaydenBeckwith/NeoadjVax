// Structural smoke test only. P1/PRE supplies a precomputed starfusion_tsv
// (bypasses STAR-Fusion calling entirely) and real rna_fastq_r1/r2 so the
// Arriba side of the branch (its own dedicated STAR pass, stubbed) is
// actually exercised. See tests/fusion/samples.csv.
params {
    fusion_callers           = 'starfusion,arriba'
    agfusion_container       = 'unused-in-stub-test'
    agfusion_database        = 'tests/fusion/agfusion.homo_sapiens.112.db'
    agfusion_pyensembl_cache = 'tests/fusion/pyensembl_cache'
    agfusion_noncanonical    = false
    fusion_min_read_support  = 5
    fusion_min_ffpm          = 0.1
    pvacfuse_algorithms         = 'MHCflurry'
    pvacfuse_threads            = 1
    pvacfuse_epitope_lengths_i  = '8,9,10,11'
    pvacfuse_epitope_lengths_ii = '15'
    pvacfuse_binding_threshold  = 500
    pvacfuse_mhcflurry_models   = 'tests/fusion/mhcflurry_models'
    pvacfuse_iedb_install_dir   = null
    genome_fasta      = 'tests/fusion/genome.fa'
    gtf               = 'tests/fusion/genome.gtf'
    star_index_dir    = 'tests/fusion/star_index_dir'
    arriba_blacklist       = 'tests/fusion/arriba_blacklist.tsv'
    arriba_known_fusions   = null
    arriba_protein_domains = null
    outdir = './test-results/fusion'
}
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    // conf/base.config's per-label cpu/memory requests (up to 128 GB, 24
    // cpus for process_high) load too now that this is combined with the
    // repo's own nextflow.config via `-c` rather than replacing it: cap
    // every label back down for this structural-only smoke test.
    withLabel: '.*' {
        cpus = 1
        memory = '1 GB'
    }
}
docker.enabled = false
singularity.enabled = false
