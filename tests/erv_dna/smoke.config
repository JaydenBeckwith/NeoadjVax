// Structural smoke test only; BAMs below are deliberately not sequencing data.
params {
    ervcaller_container = 'unused-in-stub-test'
    ervcaller_script = '/opt/ERVcaller/ERVcaller_v1.4.pl'
    ervcaller_reference_dir = null
    genome_fasta = 'tests/erv_dna/genome.fa'
    ervcaller_te_fasta = 'tests/erv_dna/te.fa'
    ervcaller_read_length = 150
    ervcaller_min_reads = 3
    ervcaller_min_split = 40
    ervcaller_bwa_mem = true
    ervcaller_genotype = true
    outdir = './test-results/erv_dna'
}
process.executor = 'local'
process.cpus = 1
process.memory = '1 GB'
docker.enabled = false
singularity.enabled = false
